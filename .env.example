# =====================================================================
# G&C Tech — variables d'environnement du front
#
# Copier ce fichier en `.env.local` pour le développement local.
# Tout ce qui est listé ici est LU PAR LE NAVIGATEUR : ne jamais y mettre de
# secret. Vite n'expose au client que les variables préfixées VITE_.
#
# Les secrets serveur (clé FedaPay, service_role Supabase) ne passent pas par
# ici : ce sont des secrets d'Edge Function, voir supabase/functions/README.md.
# =====================================================================

# Supabase — Project Settings → API.
# La clé anon est publique par conception : la sécurité repose sur la RLS.
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Numéro WhatsApp de prise de commande (format international, sans le +)
VITE_WHATSAPP_NUMBER=2290140543686

# ---------------------------------------------------------------------
# Déploiement Vercel
# Renseigner ces trois variables dans Dashboard → Settings → Environment
# Variables. Aucune autre : une variable non VITE_ n'est pas lue par le front.
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
#   VITE_WHATSAPP_NUMBER
# ---------------------------------------------------------------------
